# ========================================
# Knowledge EviGraph 环境变量示例
# ========================================
# 1. 复制本文件为 .env：  cp .env.example .env
# 2. 将占位符（your-xxx-here）替换为真实值
# 3. 本文件不应包含任何真实凭证，可安全提交到版本库
# ========================================


# ========================================
# 1. Flask 服务端配置
# ========================================
FLASK_DEBUG=False
SECRET_KEY=your-flask-secret-key-here

# 前端地址（用于生成 /chat/ 等客户端路由链接）
# 开发环境指向 Vite dev server (默认 3000 端口)
FRONTEND_URL=http://localhost:3000


# ========================================
# 2. LLM 大语言模型配置
# ========================================
# 支持任意兼容 OpenAI SDK 格式的 API（Azure OpenAI、DashScope、vLLM、Ollama 等）
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://your-llm-provider.com/v1/chat/completions
LLM_MODEL_NAME=gpt-4.1

# VLM / 多模态模型配置（用于图像分析等场景，可与 LLM 使用不同供应商）
VLM_API_KEY=sk-your-vlm-api-key-here
VLM_BASE_URL=https://your-vlm-provider.com/v1
VLM_MODEL_NAME=qwen-vl-plus


# ========================================
# 3. 图谱数据库 (Neo4j)
# ========================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here


# ========================================
# 4. 文本嵌入模型 (Embedding)
# ========================================
# 示例 A：DashScope 托管 embedding
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_DIMENSION=1024

# 示例 B：本地 Nomic Embedding 服务（取消注释并注释上方即可切换）
# EMBEDDING_MODEL=nomic-embed-text-v1.5
# EMBEDDING_BASE_URL=http://localhost:3020
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSION=768


# ========================================
# 5. 重排模型 (BGE-Reranker)
# ========================================
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=sk-your-reranker-api-key-here


# ========================================
# 6. MinerU PDF 解析服务
# ========================================
MINERU_API_URL=http://localhost:13246/MinerUApi/file_parse


# ========================================
# 7. MinIO 对象存储（可选，用于文件/图片存储）
# ========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=kb-evigraph
